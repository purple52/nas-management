# /etc/udev/rules.d/99-nas-spindown.rules
#
# Persistent hdparm spindown for the NAS data drives (the RAID member disks).
# Keyed on each disk's serial (ID_SERIAL_SHORT) rather than the sdX kernel
# name, which can reorder across reboots. Fires on `add`, so it applies on
# both boot and hotplug.
#
#   -S 241 = 30-minute standby timeout
#            (values 241-251 encode (N-240) x 30 min; 1-240 are N x 5 sec).
#
# The root drive and the USB backup drive are intentionally excluded: never spin
# down root (constant background I/O -> thrash + wear), and the backup drive is
# unlocked/mounted on demand by backup-run.
#
# DO NOT install this file verbatim -- the serials below are placeholders.
# Generate the real file on the NAS from the actual RAID members, so it can never
# pick up root or miss an array drive when device letters shuffle:
#
# (uses a `while read` pipe, not mapfile, so it works under zsh too):
#
#   {
#     echo '# NAS data-drive spindown -- hdparm -S 241 (30 min). Generated from RAID members.'
#     awk '/^md[0-9]/{for(i=1;i<=NF;i++) if($i ~ /^sd[a-z]+[0-9]*\[/){d=$i; sub(/\[.*/,"",d); sub(/[0-9]+$/,"",d); print d}}' /proc/mdstat | sort -u | while read -r d; do
#       serial=$(udevadm info -q property -n "/dev/$d" | sed -n 's/^ID_SERIAL_SHORT=//p')
#       [ -n "$serial" ] && printf 'ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]", ENV{ID_SERIAL_SHORT}=="%s", RUN+="/usr/sbin/hdparm -S 241 /dev/%%k"\n' "$serial"
#     done
#   } | sudo tee /etc/udev/rules.d/99-nas-spindown.rules
#
# Confirm hdparm's path first (command -v hdparm) and adjust the RUN path if
# it is not /usr/sbin/hdparm. KERNEL=="sd[a-z]" matches whole disks, not
# partitions. To change the timeout later, edit -S on every line.

ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]", ENV{ID_SERIAL_SHORT}=="REPLACE_WITH_sda_SERIAL", RUN+="/usr/sbin/hdparm -S 241 /dev/%k"
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]", ENV{ID_SERIAL_SHORT}=="REPLACE_WITH_sdb_SERIAL", RUN+="/usr/sbin/hdparm -S 241 /dev/%k"
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]", ENV{ID_SERIAL_SHORT}=="REPLACE_WITH_sdc_SERIAL", RUN+="/usr/sbin/hdparm -S 241 /dev/%k"
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]", ENV{ID_SERIAL_SHORT}=="REPLACE_WITH_sdd_SERIAL", RUN+="/usr/sbin/hdparm -S 241 /dev/%k"
