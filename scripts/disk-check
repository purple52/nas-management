#!/bin/bash
source /etc/nas-management.conf
SHOW_TEMPS=false

# Show temps if running as root, or if passwordless sudo for smartctl works.
# Probe with --version (no device) so it neither assumes a device letter nor
# spins a drive up — the per-drive reads below use -n standby to stay wake-safe.
if [ "$EUID" -eq 0 ] || sudo -n smartctl --version >/dev/null 2>&1; then
    SHOW_TEMPS=true
fi

echo ""
echo "=== Disk Status ==="

# RAID status
echo ""
echo "RAID Arrays:"
while IFS= read -r line; do
    if [[ "$line" =~ ^(md[0-9]+) ]]; then
        dev="${BASH_REMATCH[1]}"
        IFS= read -r next_line
        if echo "$next_line" | grep -qE '\[U+\]' && ! echo "$next_line" | grep -q '_'; then
            echo "  /dev/$dev: healthy [UU]"
        else
            echo "  /dev/$dev: ⚠ DEGRADED"
        fi
        if [[ "$next_line" =~ (check|recovery|reshape|resync) ]]; then
            echo "    $next_line"
        fi
    fi
done < /proc/mdstat

# Disk space
echo ""
echo "Storage:"
# shellcheck disable=SC2086
df -h $MONITORED_MOUNTS 2>/dev/null | tail -n+2 | while read fs size used avail pct mount; do
    pct_num=${pct%\%}
    if [ "$pct_num" -gt "$SPACE_WARN_PCT" ]; then
        echo "  $mount: ${used}/${size} (${pct}) ⚠ LOW SPACE"
    else
        echo "  $mount: ${used}/${size} (${pct})"
    fi
done

# Disk alerts
echo ""
if [ -f "$ALERT_FILE" ] && [ -s "$ALERT_FILE" ]; then
    COUNT=$(wc -l < "$ALERT_FILE")
    echo "⚠ $COUNT Disk alert(s):"
    cat "$ALERT_FILE"
    echo ""
    echo "  Run: disk-clear-alerts  to clear"
else
    echo "Disk alerts: none"
fi

# Drive temps (only if we can run smartctl)
if $SHOW_TEMPS; then
    echo ""
    echo "Drive Temperatures:"
    # shellcheck disable=SC2086
    for dev in $DISK_DEVICES; do
        [ -b "$dev" ] || continue
        # -n standby: read SMART only if the drive is already spinning. A parked
        # drive is reported as standby rather than woken — reading attributes
        # otherwise spins it up, defeating spindown on every login.
        ATTRS=$(sudo smartctl -n standby -A "$dev" 2>/dev/null)
        if [ $(( $? & 2 )) -ne 0 ]; then
            echo "  $dev: standby (not woken)"
            continue
        fi
        TEMP=$(echo "$ATTRS" | grep -i temperature | head -1 | awk -F "- *" '{print $2}' | awk '{print $1}')
        MODEL=$(sudo smartctl -n standby -i "$dev" 2>/dev/null | grep "Device Model" | sed 's/.*: *//')
        if [ -n "$TEMP" ]; then
            if [ "$TEMP" -gt "$TEMP_WARN_C" ]; then
                echo "  $dev ($MODEL): ${TEMP}°C ⚠ HOT"
            else
                echo "  $dev ($MODEL): ${TEMP}°C"
            fi
        fi
    done
fi

echo ""
echo "Disk commands:"
echo "  disk-check              Show this status"
echo "  sudo disk-check         Include drive temperatures"
echo "  disk-clear-alerts       Clear Disk alerts"
echo ""