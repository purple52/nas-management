#!/bin/bash
# One-stop backup script - figures out what needs running
source /etc/nas-management.conf
NOW=$(date +%s)

LOCKFILE="/var/run/backup-run.lock"
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    echo "Backup already running"
    exit 0
fi

cleanup() {
    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        umount "$MOUNT_POINT" 2>/dev/null
        sync
    fi
    if [ -b /dev/mapper/"$MAPPER_NAME" ]; then
        cryptsetup close "$MAPPER_NAME" 2>/dev/null
    fi
    # Park the backup drive so it doesn't sit spinning warm 24/7 while idle.
    # This USB enclosure ignores ATA standby (hdparm) but honors SCSI STOP UNIT.
    # Best-effort: a spindown failure must never affect the backup exit status.
    if [ -b "$BACKUP_DEVICE" ] && command -v sg_start >/dev/null 2>&1; then
        sg_start --stop "$BACKUP_DEVICE" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 1' TERM INT HUP

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" | tee -a "$BACKUP_STATUS_FILE"
}

# Check if drive is connected
if [ ! -b "$BACKUP_DEVICE" ]; then
    echo "Backup drive not connected."
    exit 0
fi

# Open LUKS if not already open
if [ ! -b /dev/mapper/"$MAPPER_NAME" ]; then
    cryptsetup open "$BACKUP_PARTITION" "$MAPPER_NAME" --key-file "$KEYFILE"
    if [ $? -ne 0 ]; then
        log_msg "ERROR: failed to unlock drive"
        exit 1
    fi
fi

# Mount if not already mounted
if ! mountpoint -q "$MOUNT_POINT"; then
    mkdir -p "$MOUNT_POINT"
    mount /dev/mapper/"$MAPPER_NAME" "$MOUNT_POINT"
    if [ $? -ne 0 ]; then
        log_msg "ERROR: failed to mount drive"
        exit 1
    fi
fi

# Health-check the backup drive while it's mounted and spun up. smartd no
# longer polls sdf (its 30-min poll would wake it from spindown), so this is
# where the drive's SMART health and temperature get checked. Problems are
# appended to the shared alert file so disk-check surfaces them at login.
if command -v smartctl >/dev/null 2>&1; then
    health=$(smartctl -H "$BACKUP_DEVICE" 2>/dev/null | awk -F: '/overall-health/ {print $2}' | xargs)
    if [ -n "$health" ] && [ "$health" != "PASSED" ]; then
        echo "$(date): backup drive SMART health '$health' on $BACKUP_DEVICE" >> "$ALERT_FILE"
    fi
    temp=$(smartctl -A "$BACKUP_DEVICE" 2>/dev/null | awk '$1==194 {print $10; exit}')
    if [ -n "$temp" ] && [ "$temp" -gt "$TEMP_WARN_C" ]; then
        echo "$(date): backup drive ${temp}°C exceeds ${TEMP_WARN_C}°C on $BACKUP_DEVICE" >> "$ALERT_FILE"
    fi
fi

# Determine what needs running based on last run timestamps
needs_level() {
    local level=$1
    local max_age_days=$2
    local last_file="$MOUNT_POINT/.last-${level}"

    if [ ! -f "$last_file" ]; then
        return 0
    fi

    local last_date=$(date -d "$(cat "$last_file")" +%Y-%m-%d 2>/dev/null)
    local today=$(date +%Y-%m-%d)
    local last_epoch=$(date -d "$last_date" +%s)
    local today_epoch=$(date -d "$today" +%s)
    local age_days=$(( (today_epoch - last_epoch) / 86400 ))

    [ "$age_days" -ge "$max_age_days" ]
}

RUN_MONTHLY=false
RUN_WEEKLY=false
RUN_DAILY=false

if needs_level monthly 28; then RUN_MONTHLY=true; fi
if needs_level weekly 6; then RUN_WEEKLY=true; fi
if needs_level daily 1; then RUN_DAILY=true; fi

# Run in correct order: monthly first, then weekly, then daily
ANYTHING_RAN=false

if $RUN_MONTHLY; then
    log_msg "Running monthly backup..."
    rsnapshot monthly
    if [ $? -eq 0 ]; then
        date "+%Y-%m-%d %H:%M:%S" > "$MOUNT_POINT/.last-monthly"
        log_msg "OK monthly completed"
    else
        log_msg "ERROR monthly failed"
    fi
    ANYTHING_RAN=true
fi

if $RUN_WEEKLY; then
    log_msg "Running weekly backup..."
    rsnapshot weekly
    if [ $? -eq 0 ]; then
        date "+%Y-%m-%d %H:%M:%S" > "$MOUNT_POINT/.last-weekly"
        log_msg "OK weekly completed"
    else
        log_msg "ERROR weekly failed"
    fi
    ANYTHING_RAN=true
fi

if $RUN_DAILY; then
    log_msg "Running daily backup..."
    rsnapshot daily
    if [ $? -eq 0 ]; then
        date "+%Y-%m-%d %H:%M:%S" > "$MOUNT_POINT/.last-daily"
        log_msg "OK daily completed"
    else
        log_msg "ERROR daily failed"
    fi
    ANYTHING_RAN=true
fi

if ! $ANYTHING_RAN; then
    log_msg "All backups up to date, nothing to do"
fi

log_msg "Drive unmounted and locked"